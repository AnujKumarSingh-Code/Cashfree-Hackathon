# Kramsetu configuration. Copy to .env and fill in. Never commit .env.
# Cashfree Payment Gateway, TEST mode keys (Merchant Dashboard > Developers > API Keys, after "Switch to Test")
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
# Sarvam API subscription key (Sarvam dashboard > API keys)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Relay agent "Inbound Webhook" URL (Merchant Dashboard > Relay > your agent > trigger)
RELAY_WEBHOOK_URL=
# The ONE phone number live demo calls may go to (a teammate's phone). Synthetic borrower numbers are never dialled.
DEMO_CALL_NUMBER=
# Public URL of this app, only if a tunnel is running (used as link notify_url and Relay callback)
PUBLIC_BASE_URL=
# Contact rules (configurable; confirm against the rules that apply to your lender)
CONTACT_WINDOW_START=08:00
CONTACT_WINDOW_END=19:00
CONTACT_TIMEZONE=Asia/Kolkata
MAX_ATTEMPTS_PER_WEEK=3
DAILY_CALL_CAPACITY=360
EXPLORATION_SHARE=0.10
LENDER_NAME=Kramsetu Demo Finance
GRIEVANCE_OFFICER_CONTACT=Grievance Officer, 1800-000-0000, grievance@example.invalid
# Set to 1 to force the labelled mock adapters even when keys are present
KRAMSETU_FORCE_MOCK=0
KRAMSETU_DB=kramsetu.db
# Voice call provider: auto (Sarvam direct, then Relay, then simulated), sarvam, relay, or simulated
VOICE_PROVIDER=auto
# Sarvam Voice Agents, direct outbound call (indus.sarvam.ai > Voice Agents). This key is NOT the SARVAM_API_KEY above.
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_CALLER_NUMBER=
